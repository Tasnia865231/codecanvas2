<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="14" xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.codecanvas.controller.SavedHubController"
      styleClass="saved-hub-container">
    <padding><Insets top="16" right="20" bottom="16" left="20"/></padding>

    <!-- Top Filter Header: Filter Tabs [Algorithm], [Code], [Simulator] (Figure 6) -->
    <HBox spacing="12" alignment="CENTER_LEFT" styleClass="card-panel">
        <padding><Insets top="10" right="16" bottom="10" left="16"/></padding>

        <Label text="Filter Bookmarks:" styleClass="section-title"/>
        <HBox spacing="6" alignment="CENTER_LEFT">
            <ToggleButton fx:id="allFilterBtn" text="[ All ]" styleClass="filter-tab-btn"/>
            <ToggleButton fx:id="algoFilterBtn" text="[ Algorithm ]" styleClass="filter-tab-btn"/>
            <ToggleButton fx:id="codeFilterBtn" text="[ Code ]" styleClass="filter-tab-btn"/>
            <ToggleButton fx:id="simFilterBtn" text="[ Simulator ]" styleClass="filter-tab-btn"/>
        </HBox>

        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="statusSummaryLabel" text="Loading saved items..." styleClass="subtle-label"/>
    </HBox>

    <!-- Master-Detail SplitPane: Table on Left, Content Inspector on Right (Figure 7) -->
    <SplitPane dividerPositions="0.48" VBox.vgrow="ALWAYS" styleClass="dashboard-split-pane">
        
        <!-- Left: Itemized List of Saved Items from SQLite (Figure 6) -->
        <VBox spacing="8" styleClass="table-panel">
            <padding><Insets top="12" right="12" bottom="12" left="12"/></padding>

            <Label text="Saved Bookmarks (SQLite)" styleClass="section-title"/>
            <TableView fx:id="savedTable" VBox.vgrow="ALWAYS" styleClass="modern-table">
                <columns>
                    <TableColumn fx:id="colId" text="ID" prefWidth="45"/>
                    <TableColumn fx:id="colType" text="Type" prefWidth="95"/>
                    <TableColumn fx:id="colAlgo" text="Algorithm" prefWidth="110"/>
                    <TableColumn fx:id="colTitle" text="Title" prefWidth="150"/>
                    <TableColumn fx:id="colSavedAt" text="Saved At" prefWidth="130"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>
        </VBox>

        <!-- Right: Saved Content Inspector (Figure 7) -->
        <VBox spacing="10" styleClass="detail-panel">
            <padding><Insets top="12" right="16" bottom="12" left="16"/></padding>

            <HBox spacing="8" alignment="CENTER_LEFT">
                <Label fx:id="detailAlgoTitleLabel" text="Select an item to view content" styleClass="detail-title" HBox.hgrow="ALWAYS"/>
                <Label fx:id="detailTypeBadge" text="" styleClass="badge-pill"/>
            </HBox>
            
            <Label fx:id="detailSavedAtLabel" text="" styleClass="subtle-label"/>

            <TextArea fx:id="detailContentArea" editable="false" wrapText="true" VBox.vgrow="ALWAYS" 
                      styleClass="saved-content-view"/>

            <HBox spacing="10" alignment="CENTER_RIGHT">
                <Button fx:id="deleteBookmarkBtn" text="🗑 Delete Bookmark" styleClass="danger-btn" disable="true"/>
                <Button fx:id="openInHubBtn" text="Open in Detail Hub →" styleClass="accent-btn" disable="true"/>
            </HBox>
        </VBox>

    </SplitPane>
</VBox>
