<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane fx:id="shellRoot" xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.codecanvas.controller.MainShellController"
            stylesheets="@style.css"
            prefWidth="1140" prefHeight="780">

    <!-- SINGLE UNIFIED HEADER BAR: Logo, Search Bar, Theme Selector, ONE Profile Chip -->
    <top>
        <VBox styleClass="header-bar">
            <HBox fx:id="navHeaderHBox" spacing="12" alignment="CENTER_LEFT" styleClass="nav-header">
                <padding><Insets top="8" right="16" bottom="8" left="16"/></padding>
                
                <Button fx:id="backButton" text="← Back" styleClass="back-btn" visible="false" managed="false"/>
                
                <Label fx:id="brandLabel" text="CodeCanvas" styleClass="brand-logo"/>
                <Label text="|" styleClass="separator-label"/>
                <Label fx:id="screenTitleLabel" text="Algorithm Dashboard" styleClass="header-title"/>
                
                <Region HBox.hgrow="ALWAYS"/>
                
                <HBox spacing="10" alignment="CENTER_RIGHT">
                    <!-- Unified Search Bar in Header Bar -->
                    <TextField fx:id="headerSearchField" promptText="🔍 Search algorithms..." prefWidth="200" 
                               styleClass="header-search-field" visible="false" managed="false"/>

                    <Label text="Theme:" styleClass="subtle-label"/>
                    <ChoiceBox fx:id="globalThemeChoiceBox" prefWidth="115" styleClass="modern-choice-box"/>
                    
                    <!-- CONSOLIDATED SINGLE PROFILE CHIP (No duplicate buttons) -->
                    <Button fx:id="userProfileChip" text="👤 Profile" styleClass="profile-chip-btn" 
                            onAction="#onProfileClicked" visible="false" managed="false"/>
                    
                    <Button fx:id="logoutButton" text="Logout" styleClass="logout-btn" 
                            onAction="#onLogoutClicked" visible="false" managed="false"/>
                </HBox>
            </HBox>
        </VBox>
    </top>

    <center>
        <StackPane fx:id="contentHost" styleClass="content-area"/>
    </center>

    <bottom>
        <HBox styleClass="status-bar" alignment="CENTER_LEFT">
            <padding><Insets top="4" right="14" bottom="4" left="14"/></padding>
            <Label fx:id="globalStatusLabel" text="CodeCanvas Initialized"/>
        </HBox>
    </bottom>
</BorderPane>
